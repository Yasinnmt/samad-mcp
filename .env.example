# Samad MCP - environment variables
# 1) Copy this file to .env   2) Fill in the two values below
# .env stays local only and is never committed to Git (see .gitignore)

# Student ID (your username in the Samad system)
SAMAD_USERNAME=

# Your Samad password
SAMAD_PASSWORD=

# University API base URL - default: University of Guilan
SAMAD_BASE_URL=https://food.guilan.ac.ir